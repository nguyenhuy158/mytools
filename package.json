{
	"name": "toolhub",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm build && wrangler deploy --config build/server/wrangler.json",
		"dev": "react-router dev",
		"postinstall": "pnpm cf-typegen",
		"preview": "pnpm build && vite preview",
		"typecheck": "pnpm cf-typegen && react-router typegen && tsc -b",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"shots": "node scripts/refresh-project-shots.mjs"
	},
	"dependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"@tiptap/extension-link": "^3.14.0",
		"@tiptap/extension-underline": "^3.14.0",
		"@tiptap/pm": "^3.14.0",
		"@tiptap/react": "^3.14.0",
		"@tiptap/starter-kit": "^3.14.0",
		"@types/diff": "^7.0.2",
		"@xenova/transformers": "^2.17.2",
		"date-fns": "^4.1.0",
		"diff": "^8.0.2",
		"html2markdown": "^1.1.0",
		"i18next": "^25.7.2",
		"i18next-browser-languagedetector": "^8.2.0",
		"i18next-http-backend": "^3.0.2",
		"isbot": "^5.1.31",
		"json5": "^2.2.3",
		"kbar": "0.1.0-beta.48",
		"leaflet": "^1.9.4",
		"lucide-react": "^0.560.0",
		"lunar-javascript": "^1.7.7",
		"mermaid": "^11.12.2",
		"nuqs": "^2.8.6",
		"pdf-lib": "^1.17.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-i18next": "^16.4.1",
		"react-leaflet": "^5.0.0",
		"react-markdown": "^10.1.0",
		"react-router": "^7.10.0",
		"sonner": "^2.0.7",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.5",
		"@react-router/dev": "^7.10.0",
		"@tailwindcss/vite": "^4.1.13",
		"@testing-library/jest-dom": "^6.1.5",
		"@testing-library/react": "^14.1.2",
		"@types/json5": "^0.0.30",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^22",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^4.2.1",
		"@vitest/coverage-v8": "^1.1.0",
		"@vitest/ui": "^1.1.0",
		"happy-dom": "^12.10.3",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vite-plugin-pwa": "^1.2.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^1.1.0",
		"wrangler": "^4.54.0"
	}
